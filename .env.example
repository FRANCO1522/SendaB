# ───────────────────────────────────────────────────────────────────────────
# Senda B · variables de entorno (todas opcionales)
# El sitio funciona sin configurar nada. En Render, PORT lo asigna la
# plataforma automáticamente, así que no hace falta definir variables.
# ───────────────────────────────────────────────────────────────────────────

# Puerto del servidor local (por defecto 3000).
PORT=3000

# Interfaz de escucha (por defecto 0.0.0.0, necesario en Render).
# HOST=0.0.0.0
